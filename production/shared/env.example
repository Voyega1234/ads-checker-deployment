# Shared env contract for production worker and report viewer.
# Do not commit real values.

# Meta
META_ACCESS_TOKEN=
META_API_VERSION=v25.0
META_AD_ACCOUNT_ID=
META_AD_ACCOUNT_IDS=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=ads-compliance
SUPABASE_STORAGE_PREFIX=ad-preview-checker

# Slack
SLACK_BOT_TOKEN=
SLACK_OVERRIDE_CHANNEL_ID=
SLACK_MESSAGE_DELAY_MS=750
SLACK_MAX_RETRIES=3

# Placement checker runtime
AD_FORMATS=INSTAGRAM_STORY,INSTAGRAM_REELS,FACEBOOK_REELS_MOBILE,FACEBOOK_STORY_MOBILE,MOBILE_FEED_STANDARD,INSTAGRAM_STANDARD
AD_LIMIT=all
QUERY_ACTIVE_ONLY=1
ENFORCE_ACTIVE_DELIVERY=1
AD_CONCURRENCY=2
PLACEMENT_CONCURRENCY=4
PREVIEW_WAIT_MS=5000
PREVIEW_RETRIES=2

# Report viewer
REPORT_VIEWER_URL=https://report-viewer-theta.vercel.app/report-viewer

# Manual trigger API
RUN_TRIGGER_TOKEN=
GCP_PROJECT_ID=
CLOUD_RUN_REGION=asia-southeast1
CLOUD_RUN_JOB_NAME=ad-compliance-worker
# CLOUD_RUN_JOB_RESOURCE=projects/<project>/locations/<region>/jobs/<job>

# Output
OUTPUT_DIR=output
